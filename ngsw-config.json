{
  "$schema": "https://raw.githubusercontent.com/angular/angular/20.0.x/packages/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/assets/**",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "icons",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/svg/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "firebase",
      "urls": [
        "https://firebasestorage.googleapis.com/**",
        "https://firestore.googleapis.com/**",
        "https://identitytoolkit.googleapis.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "10s"
      }
    }
  ]
}

